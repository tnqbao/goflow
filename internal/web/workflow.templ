package web

import "github.com/tnqbao/kubereel/internal/workflow"

templ MockWorkflowForm(message string) {
 @Layout("Mock workflow") {
  <header class="page-header">
   <div>
    <p class="eyebrow">Mock provider</p>
    <h1>Mock workflow</h1>
    <p class="page-description">Create a test SVG without external credentials or AI credits.</p>
   </div>
  </header>
  if message != "" {
   <p role="alert">{ message }</p>
  }
  <form class="mock-form" action="/workflows" method="post">
   <label for="prompt">Scene description</label>
   <textarea id="prompt" name="prompt" maxlength="8192" required rows="5"></textarea>
   <button class="provider-button" type="submit">Run mock workflow</button>
  </form>
 }
}

templ MockWorkflowStatus(item workflow.Workflow) {
 @Layout("Mock workflow") {
  <header class="page-header">
   <div>
    <p class="eyebrow">Mock provider</p>
    <h1>Workflow status</h1>
   </div>
  </header>
  <p><strong>Status:</strong> { item.Status }</p>
  <p><strong>Scene:</strong> { item.Prompt }</p>
  if item.Status == "succeeded" {
   <p><a href={ templ.SafeURL("/api/workflows/" + item.ID + "/artifact") }>Download mock SVG</a></p>
  } else if item.Status == "failed" {
   <p role="alert">{ item.Error }</p>
  } else {
   <p><a href={ templ.SafeURL("/workflows/" + item.ID) }>Refresh status</a></p>
  }
  <p><a href="/workflows">Start another mock workflow</a></p>
 }
}
