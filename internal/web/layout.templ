package web

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · KubeReel</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<div class="app-shell">
				<aside class="sidebar" aria-label="Workspace">
					<a class="brand" href="/" aria-label="KubeReel home">KubeReel<span aria-hidden="true">.</span></a>
					<p class="sidebar-label">Workspace</p>
					<nav aria-label="Main navigation">
						if title == "Projects" {
							<a class="sidebar-item" href="/" aria-current="page">Projects</a>
						} else {
							<a class="sidebar-item" href="/">Projects</a>
						}
						<p class="sidebar-label">Settings</p>
						if title == "Providers" {
							<a class="sidebar-item" href="/settings/providers" aria-current="page">Providers</a>
						} else {
							<a class="sidebar-item" href="/settings/providers">Providers</a>
						}
					</nav>
				</aside>
				<main id="main-content" class="main-content" tabindex="-1">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}
