package web

templ Home() {
	@Layout("Projects") {
		<header class="page-header">
			<div>
				<p class="eyebrow">Your creative space</p>
				<h1>Projects</h1>
				<p class="page-description">A home for your stories, from first idea to final scene.</p>
			</div>
			@Badge("Coming soon")
		</header>
		@EmptyState("Your stories start here", "Project creation is coming soon. Your workspace will be ready when it arrives.")
	}
}
