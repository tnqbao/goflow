{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "persistence": {
      "type": "object",
      "properties": {
        "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
        "existingClaim": {"type": "string"}
      }
    },
    "workflow": {
      "type": "object",
      "properties": {"maxConcurrent": {"type": "integer", "minimum": 1}}
    },
    "image": {
      "type": "object",
      "properties": {"pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}
    }
  }
}
